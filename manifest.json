{
  "manifest_version": 3,
  "name": "Copy Title & URL",
  "version": "1.0.1",
  "description": "ページタイトルとURLをコピーするツールバーボタン",
  "browser_specific_settings": {
    "gecko": {
      "id": "copy-title-url@godhexagon",
      "update_url": "https://godhexagon.github.io/copy_tool_firefox/updates.json",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "タイトルをリンク付きでコピー（右クリックでメニュー）",
    "default_icon": "icons/icon.svg",
    "default_area": "navbar"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["activeTab", "menus", "clipboardWrite"]
}
