{
  "manifest_version": 3,
  "name": "Copy Title & URL",
  "version": "1.0.0",
  "description": "ページタイトルとURLをコピーするツールバーボタン",
  "browser_specific_settings": {
    "gecko": {
      "id": "copy-title-url@example.local",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "タイトルをリンク付きでコピー（右クリックでメニュー）",
    "default_icon": "icons/icon.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["activeTab", "menus", "clipboardWrite"]
}
